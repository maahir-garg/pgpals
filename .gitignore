# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local working notes, not for the public repo
pgpals-design-and-prompts.md

# screenshot output from scripts/walkthrough.ts and scripts/e2e-browser.ts
/walkthrough-shots/
/e2e-shots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups from scripts/backup.ts (may contain personal data)
/backups/
