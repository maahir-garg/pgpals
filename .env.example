# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for signed photos and email-rate-limit-safe signup.
# NEVER expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Put this in the gitignored .env.event.local before running the final seed.
# It is used only to create/update the shared RA checker account.
PGPALS_SHARED_ADMIN_PASSWORD=
